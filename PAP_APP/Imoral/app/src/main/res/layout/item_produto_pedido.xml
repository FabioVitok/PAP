<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/carrinho_background"
    android:clickable="true"
    android:focusable="true"
    android:padding="6dp"
    android:layout_marginVertical="6dp">

    <ImageView
        android:id="@+id/ivProdutoImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvProdutoName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="Nome do Produto"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/ivProdutoImage"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvProdutoTamanho"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tamanho: M"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/ivProdutoImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProdutoName" />

    <TextView
        android:id="@+id/tvProdutoQuantidade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Quantidade: 0"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/ivProdutoImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProdutoTamanho" />

    <TextView
        android:id="@+id/tvProdutoPriceAlone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Preço individual:     0,00€"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/ivProdutoImage"
        app:layout_constraintTop_toBottomOf="@id/tvProdutoQuantidade" />

    <TextView
        android:id="@+id/tvProdutoPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Preço individual:     0,00€"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/ivProdutoImage"
        app:layout_constraintTop_toBottomOf="@id/tvProdutoPriceAlone" />



</androidx.constraintlayout.widget.ConstraintLayout>