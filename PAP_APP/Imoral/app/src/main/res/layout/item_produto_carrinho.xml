<?xml version="1.0" encoding="utf-8"?>
<!-- android:background="?attr/selectableItemBackground" -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/carrinho_background"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginVertical="6dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivProdutoImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_launcher_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <TextView
        android:id="@+id/tvProdutoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nome do Produto"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginStart="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/tvProdutoTamanho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tamanho: M"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:layout_marginStart="12dp"
        android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProdutoPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0,00€"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginStart="12dp"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btnMenos"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:paddingStart="6dp"
                android:paddingEnd="5dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textSize="18sp"
                android:text="-"
                android:textColor="@color/white"
                android:background="@drawable/blackbutton_background"
                app:backgroundTint="@null"/>

            <TextView
                android:id="@+id/tvQuantidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center" />

            <Button
                android:id="@+id/btnMais"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:paddingStart="6dp"
                android:paddingEnd="5dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textSize="18sp"
                android:text="+"
                android:textColor="@color/white"
                android:background="@drawable/blackbutton_background"
                app:backgroundTint="@null"/>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>

</LinearLayout>