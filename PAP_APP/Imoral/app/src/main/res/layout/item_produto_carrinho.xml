<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/carrinho_background"
    android:clickable="true"
    android:focusable="true"
    android:padding="6dp"
    android:layout_marginVertical="6dp">

    <ImageView
        android:id="@+id/ivProdutoImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvProdutoName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nome do Produto"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginStart="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"
        app:layout_constraintStart_toEndOf="@id/ivProdutoImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvProdutoTamanho"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tamanho: M"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:layout_marginStart="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toEndOf="@id/ivProdutoImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProdutoName" />

    <TextView
        android:id="@+id/tvProdutoPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0,00€"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginStart="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toEndOf="@id/ivProdutoImage"
        app:layout_constraintEnd_toStartOf="@id/btnMenos"
        app:layout_constraintTop_toTopOf="@id/btnMenos"
        app:layout_constraintBottom_toBottomOf="@id/btnMenos" />

    <Button
        android:id="@+id/btnMenos"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="8dp"
        android:paddingStart="6dp"
        android:paddingEnd="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textSize="18sp"
        android:text="-"
        android:textColor="@color/white"
        android:background="@drawable/blackbutton_background"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toStartOf="@id/tvQuantidade"
        app:layout_constraintTop_toBottomOf="@id/tvProdutoTamanho" />

    <TextView
        android:id="@+id/tvQuantidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@id/btnMais"
        app:layout_constraintTop_toTopOf="@id/btnMais"
        app:layout_constraintBottom_toBottomOf="@id/btnMais" />

    <Button
        android:id="@+id/btnMais"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:paddingStart="6dp"
        android:paddingEnd="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textSize="18sp"
        android:text="+"
        android:textColor="@color/white"
        android:background="@drawable/blackbutton_background"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProdutoTamanho" />

    <ImageButton
        android:id="@+id/btnRemover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/trash"
        android:backgroundTint="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
         />

</androidx.constraintlayout.widget.ConstraintLayout>