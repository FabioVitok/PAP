<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/carrinho_background"
    android:clickable="true"
    android:focusable="true"
    android:padding="6dp"
    android:layout_marginVertical="6dp">

    <TextView
        android:id="@+id/tvIdPedidoTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="Id Pedido:"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvIdPedido"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@id/tvIdPedidoTitle"
        app:layout_constraintTop_toTopOf="@id/tvIdPedidoTitle" />

    <TextView
        android:id="@+id/tvDataTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginTop="7dp"
        android:text="Data da compra:"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/tvIdPedidoTitle"
        app:layout_constraintTop_toBottomOf="@id/tvIdPedidoTitle" />

    <TextView
        android:id="@+id/tvData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/tvDataTitle"
        app:layout_constraintTop_toTopOf="@id/tvDataTitle" />

    <TextView
        android:id="@+id/tvValorTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginTop="5dp"
        android:text="Valor da Compra:"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/tvIdPedidoTitle"
        app:layout_constraintTop_toBottomOf="@id/tvDataTitle" />

    <TextView
        android:id="@+id/tvValor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/tvValorTitle"
        app:layout_constraintTop_toTopOf="@id/tvValorTitle" />

    <TextView
        android:id="@+id/tvMoradaTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginTop="5dp"
        android:text="Morada de entrega:"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/tvIdPedidoTitle"
        app:layout_constraintTop_toBottomOf="@id/tvValorTitle" />

    <TextView
        android:id="@+id/tvMorada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/tvMoradaTitle"
        app:layout_constraintTop_toTopOf="@id/tvMoradaTitle" />




</androidx.constraintlayout.widget.ConstraintLayout>