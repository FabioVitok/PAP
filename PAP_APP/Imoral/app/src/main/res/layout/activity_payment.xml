<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PaymentActivity"
    android:background="@color/background_gray">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="3dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Confirmação de compra"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnBack"/>

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/black"
                android:layout_marginTop="17dp"
                android:layout_marginStart="15dp"
                app:srcCompat="@drawable/back_white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutDados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/carrinho_background"
                android:padding="10dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/TvTitleMorada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Endereço de Entrega"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginTop="7dp"
                    app:layout_constraintTop_toBottomOf="@id/TvTitleMorada"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvTelefone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginTop="7dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toBottomOf="@id/TvTitleMorada"
                    app:layout_constraintStart_toEndOf="@id/tvNome"/>

                <TextView
                    android:id="@+id/tvMorada"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginTop="1dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toBottomOf="@id/tvNome"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvEndereco"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginTop="1dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toBottomOf="@id/tvMorada"
                    app:layout_constraintStart_toStartOf="parent"/>

                <ImageButton
                    android:id="@+id/ibtnMorada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/black"
                    android:layout_marginEnd="15dp"
                    app:srcCompat="@drawable/enter_white"
                    app:layout_constraintTop_toTopOf="@id/tvMorada"
                    app:layout_constraintBottom_toBottomOf="@id/tvMorada"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvTitleCarrinho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Produtos no Carrinho"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toBottomOf="@id/layoutDados"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarrinho"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitleCarrinho"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/tvTitlePagamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Escolha um método de pagamento"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toBottomOf="@id/rvCarrinho"
                app:layout_constraintStart_toStartOf="parent"/>

            <RadioGroup
                android:id="@+id/groupPagamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvTitlePagamento"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RadioButton
                    android:id="@+id/btnCreditCard"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Cartão de Crédito"
                    android:padding="7dp"
                    android:drawablePadding="14dp"
                    android:drawableStart="@drawable/credit_card"
                    android:textColor="@color/white"/>

                <RadioButton
                    android:id="@+id/btnPaypal"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Paypal"
                    android:padding="7dp"
                    android:drawablePadding="14dp"
                    android:drawableStart="@drawable/paypal"
                    android:textColor="@color/white"/>


                <RadioButton
                    android:id="@+id/btnMbWay"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="MB WAY"
                    android:padding="7dp"
                    android:drawablePadding="14dp"
                    android:drawableStart="@drawable/mbway"
                    android:textColor="@color/white"/>

            </RadioGroup>

            <View
                android:id="@+id/dividerTotal"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#333333"
                app:layout_constraintTop_toBottomOf="@id/groupPagamento"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />




            <TextView
                android:id="@+id/tvTitlePreco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preço do Carrinho"
                android:textColor="@color/white"
                android:layout_marginTop="10dp"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toBottomOf="@id/dividerTotal"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvPreco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00,00€"
                android:textColor="@color/white"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@id/groupPagamento"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvTitleFrete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frete"
                android:textColor="@color/white"
                android:layout_marginTop="5dp"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitlePreco"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvFrete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00,00€"
                android:textColor="@color/white"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvPreco"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvTitleTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preço total da encomenta"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitleFrete"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00,00€"
                android:textColor="@color/white"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="12dp"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/tvFrete"
                app:layout_constraintEnd_toEndOf="parent"/>


            <Button
                android:id="@+id/btnComprar"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginTop="35dp"
                android:background="@drawable/blackbutton_background"
                android:text="Finalizar a Compra"
                android:textColor="@color/white"
                app:backgroundTint="@null"
                app:layout_constraintTop_toBottomOf="@id/tvTotal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>



        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>