<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_gray">




    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProfilePicture"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_weight="0"
        android:layout_marginStart="23dp"
        android:layout_marginTop="25dp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:layout_marginStart="11dp"
        android:layout_marginTop="37dp"
        app:layout_constraintStart_toEndOf="@id/ivProfilePicture"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Username"
        android:textColor="@color/white"
        android:textSize="16sp"
        />

    <TextView
        android:id="@+id/tvData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:layout_marginEnd="23dp"
        android:layout_gravity="center"
        android:layout_marginTop="42dp"
        android:textSize="10sp"
        android:text="25 Dec 2025"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/tvTexto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="23dp"
        android:layout_marginEnd="55dp"
        android:layout_marginBottom="20dp"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:gravity="start"
        android:text="Lorem ipsum dolor sit amet..."
        app:layout_constraintTop_toBottomOf="@id/ivProfilePicture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="5dp"
        android:backgroundTint="@color/black"
        app:layout_constraintTop_toBottomOf="@id/tvData"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvRespostas"
        app:srcCompat="@drawable/heartwishlist" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/imageButton2"
        app:layout_constraintEnd_toEndOf="@id/imageButton2"
        app:layout_constraintStart_toStartOf="@id/imageButton2"
        android:textSize="12sp" />
    
    <ImageButton
        android:id="@+id/btnRespostas"
        android:layout_width="25dp"
        android:layout_height="20dp"
        android:backgroundTint="@color/black"
        android:layout_marginTop="10dp"
        android:layout_marginStart="23dp"
        app:layout_constraintTop_toBottomOf="@id/tvTexto"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/answericon"/>


    <TextView
        android:id="@+id/tvRespostasCount"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginStart="3dp"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="start"
        android:text="24"
        app:layout_constraintTop_toTopOf="@id/btnRespostas"
        app:layout_constraintBottom_toBottomOf="@id/btnRespostas"
        app:layout_constraintStart_toEndOf="@id/btnRespostas" />

    <TextView
        android:id="@+id/tvRespostas"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginStart="3dp"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="start"
        android:text="Respostas"
        app:layout_constraintTop_toTopOf="@id/btnRespostas"
        app:layout_constraintBottom_toBottomOf="@id/btnRespostas"
        app:layout_constraintStart_toEndOf="@id/tvRespostasCount" />

    <TextView
        android:id="@+id/btnResponder"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginStart="15dp"
        android:textSize="10sp"
        android:textColor="#7C7C7C"
        android:text="Responder"
        android:paddingTop="5dp"
        app:layout_constraintTop_toTopOf="@id/tvRespostas"
        app:layout_constraintBottom_toBottomOf="@id/tvRespostas"
        app:layout_constraintStart_toEndOf="@id/tvRespostas" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRespostas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/tvRespostas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />




</androidx.constraintlayout.widget.ConstraintLayout>